# Environment Configuration
# Copy this file to .env and fill in your values

# Network Configuration
NETWORK=development
TRAC_CHANNEL=dmt_pattern_hunter_testnet_r1
BOOTSTRAP_PEER=

# Block Data Sources
# blockchain.info API (primary source)
BLOCKCHAIN_INFO_URL=https://blockchain.info

# Bitcoin Core RPC (optional fallback, unlimited access)
BITCOIN_CORE_URL=http://127.0.0.1:8332
BITCOIN_CORE_USERNAME=
BITCOIN_CORE_PASSWORD=

# TAP API Configuration
# Used for pattern verification and inscription data
# Examples: https://fra-01.tap-reader.xyz, https://ord-tap.trac.network
ORD_TAP_HOST=https://fra-01.tap-reader.xyz

# Debug Mode
# Set to true to see detailed logging
DEBUG=false

# Feature Flags
ENABLE_WEBSOCKET=false
ENABLE_REST=false
ENABLE_GOSSIP=true

# Rate Limiting (overrides config.json)
# RATE_LIMIT_OVERRIDE=100
