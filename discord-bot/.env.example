# Discord Bot Environment Variables

# Discord Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Channel IDs (Optional)
DISCORD_ANNOUNCEMENTS_CHANNEL=your_announcements_channel_id_here
DISCORD_LOGS_CHANNEL=your_logs_channel_id_here

# Role IDs (Optional - for permissions)
DISCORD_VERIFIED_ROLE=your_verified_role_id_here
DISCORD_TRUSTED_ROLE=your_trusted_role_id_here

# Block Data Sources
BLOCKCHAIN_INFO_URL=https://blockchain.info

# Bitcoin Core RPC (Optional - fallback source, unlimited access)
BITCOIN_CORE_URL=http://127.0.0.1:8332
BITCOIN_CORE_USERNAME=your_rpc_username
BITCOIN_CORE_PASSWORD=your_rpc_password

# TAP API Configuration (used for pattern verification and inscription data)
ORD_TAP_HOST=https://fra-01.tap-reader.xyz

# Debug Mode
DEBUG=false
